<Window x:Class="PKTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:views="clr-namespace:PKTracker.App.Views"
        Title="PKTracker" Icon="PKTracker.ico" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI" FontSize="12"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="БД: " Style="{StaticResource Dim}" />
                <TextBlock x:Name="DbStatusText" Text="—" Margin="0,0,16,0" />
                <TextBlock Text="Авто-импорт: " Style="{StaticResource Dim}" />
                <TextBlock x:Name="WatcherStatusText" Text="—" />
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Style="{StaticResource NavTabs}" SelectionChanged="Tabs_SelectionChanged">

            <!-- ── Обзор ───────────────────────────────────────────── -->
            <TabItem Header="Обзор" x:Name="OverviewTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="270" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="OverviewKind" Width="120" SelectedIndex="0" SelectionChanged="OverviewKind_Changed">
                            <ComboBoxItem Content="Кеш" />
                            <ComboBoxItem Content="Турниры" />
                        </ComboBox>
                        <Button Style="{StaticResource AccentButton}" Content="Обновить" Margin="8,0,0,0" Click="RefreshOverview_Click" />
                        <TextBlock x:Name="OverviewNote" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Rows="1" Margin="0,10,0,10" x:Name="KpiPanel">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                            <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="Раздачи" /><TextBlock x:Name="KpiHands" Style="{StaticResource Kpi}" Text="—" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel><TextBlock x:Name="KpiNetLabel" Style="{StaticResource KpiLabel}" Text="Выигрыш" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="KpiNet" Style="{StaticResource SignKpi}" Text="—" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="bb/100" /><TextBlock x:Name="KpiBb100" Style="{StaticResource SignKpi}" Text="—" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel><TextBlock x:Name="KpiEvLabel" Style="{StaticResource KpiLabel}" Text="All-in EV bb/100" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="KpiEvBb100" Style="{StaticResource SignKpi}" Text="—" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="Рейк" /><TextBlock x:Name="KpiRake" Style="{StaticResource Kpi}" Text="—" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="VPIP / PFR" /><TextBlock x:Name="KpiVpip" Style="{StaticResource Kpi}" Text="—" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel><TextBlock Style="{StaticResource KpiLabel}" Text="Часы / сессии" /><TextBlock x:Name="KpiHours" Style="{StaticResource Kpi}" Text="—" /></StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                        <sp:WpfPlot x:Name="NetPlot" />
                    </Border>
                    <!-- UniformGrid делит ширину между видимыми таблицами: «По лимитам» у турниров скрыта, и две оставшиеся занимают её место. -->
                    <UniformGrid Grid.Row="3" Rows="1">
                        <DockPanel Margin="0,0,6,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="По позициям" />
                            <DataGrid x:Name="ByPositionGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Позиция" Binding="{Binding Key}" />
                                    <DataGridTextColumn Header="Руки" Binding="{Binding Hands, Converter={StaticResource Num}}" />
                                    <DataGridTextColumn Header="bb/100" Binding="{Binding Bb100, StringFormat=F1}" ElementStyle="{StaticResource SignCell}" />
                                    <DataGridTextColumn Header="VPIP" Binding="{Binding VpipPct, StringFormat=F0}" />
                                    <DataGridTextColumn Header="PFR" Binding="{Binding PfrPct, StringFormat=F0}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel x:Name="ByLimitPanel" Margin="0,0,6,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="По лимитам" />
                            <DataGrid x:Name="ByLimitGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Лимит" Binding="{Binding Key}" />
                                    <DataGridTextColumn Header="Руки" Binding="{Binding Hands, Converter={StaticResource Num}}" />
                                    <DataGridTextColumn Header="bb/100" Binding="{Binding Bb100, StringFormat=F1}" ElementStyle="{StaticResource SignCell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="По числу игроков" />
                            <DataGrid x:Name="BySizeGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Раздано" Binding="{Binding Key}" />
                                    <DataGridTextColumn Header="Руки" Binding="{Binding Hands, Converter={StaticResource Num}}" />
                                    <DataGridTextColumn Header="bb/100" Binding="{Binding Bb100, StringFormat=F1}" ElementStyle="{StaticResource SignCell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <!-- ── Сессии ──────────────────────────────────────────── -->
            <TabItem Header="Сессии" x:Name="SessionsTab">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ComboBox x:Name="SessionsKind" DockPanel.Dock="Left" Width="120" SelectedIndex="0" SelectionChanged="SessionsKind_Changed">
                            <ComboBoxItem Content="Кеш" />
                            <ComboBoxItem Content="Турниры" />
                        </ComboBox>
                        <TextBlock x:Name="SessionsNote" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Text="Перерыв между раздачами больше заданного в настройках — новая сессия." />
                    </DockPanel>
                    <DataGrid x:Name="SessionsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Начало" Binding="{Binding StartLocal, StringFormat=dd.MM.yyyy HH:mm}" />
                            <DataGridTextColumn Header="Длительность" Binding="{Binding DurationText}" />
                            <DataGridTextColumn Header="Руки" Binding="{Binding Hands, Converter={StaticResource Num}}" />
                            <DataGridTextColumn x:Name="SessionsTourneysColumn" Header="Турниров" Binding="{Binding Tournaments}" Visibility="Collapsed" />
                            <DataGridTextColumn Header="Столов" Binding="{Binding Tables}" />
                            <DataGridTextColumn x:Name="SessionsNetColumn" Header="Выигрыш" Binding="{Binding NetText}" ElementStyle="{StaticResource SignCell}" />
                            <DataGridTextColumn Header="bb/100" Binding="{Binding Bb100Text}" ElementStyle="{StaticResource SignCell}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ── Турниры ─────────────────────────────────────────── -->
            <TabItem Header="Турниры" x:Name="TournamentsTab">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- Форматов обычно несколько строк, а график без высоты не читается: ему достаётся основная доля. -->
                        <RowDefinition Height="2*" MinHeight="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="170" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="100" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <DockPanel ToolTip="Папка с итогами турниров из клиента — просматриваются и подпапки. Место, призы, баунти и размер поля есть только в .ots, в hand history их нет. Повторная загрузка не делает дублей: турнир обновляется.">
                            <TextBlock DockPanel.Dock="Left" Text="Итоги турниров (.ots):" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button DockPanel.Dock="Right" Content="Обновить" Click="TournamentsRefresh_Click" Margin="6,0,0,0" />
                            <Button DockPanel.Dock="Right" x:Name="TournamentLoadButton" Style="{StaticResource AccentButton}"
                                    Content="Загрузить итоги" Click="TournamentLoad_Click" Margin="6,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="Обзор…" Click="TournamentBrowse_Click" Margin="6,0,0,0" />
                            <TextBox x:Name="TournamentFolderBox" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar x:Name="TournamentProgressBar" Height="6" Margin="0,4,0,2" Visibility="Collapsed" />
                        <TextBlock x:Name="TournamentLoadStatus" TextWrapping="Wrap" Style="{StaticResource Dim}" Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock x:Name="TournamentSummaryText" Grid.Row="1" Margin="0,6,0,4" TextWrapping="Wrap" />

                    <DockPanel Grid.Row="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Все форматы" Click="FormatsReset_Click" />
                            <TextBlock Style="{StaticResource H}" VerticalAlignment="Center"
                                       Text="Форматы (выберите строку — график и список ниже отфильтруются)" />
                        </DockPanel>
                        <DataGrid x:Name="FormatsGrid" SelectionMode="Single" SelectionChanged="FormatsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Формат" Binding="{Binding Format}" MinWidth="150" />
                                <DataGridTextColumn Header="Турниров" Binding="{Binding Count}" />
                                <DataGridTextColumn Header="С раздачами" Binding="{Binding WithHands}" />
                                <DataGridTextColumn Header="Входов" Binding="{Binding Entries}" />
                                <DataGridTextColumn Header="Руки" Binding="{Binding Hands, Converter={StaticResource Num}}" />
                                <DataGridTextColumn Header="ITM" Binding="{Binding ItmText}" />
                                <DataGridTextColumn Header="Ср. место" Binding="{Binding AvgFinishText}" />
                                <DataGridTextColumn Header="Затраты" Binding="{Binding CostText}" />
                                <DataGridTextColumn Header="Призы" Binding="{Binding WonText}" />
                                <DataGridTextColumn Header="Профит" Binding="{Binding ProfitText}" ElementStyle="{StaticResource SignCell}" />
                                <DataGridTextColumn Header="ROI" Binding="{Binding RoiText}" ElementStyle="{StaticResource SignCell}" />
                                <DataGridTextColumn Header="$EV" Binding="{Binding DollarEvText}" ElementStyle="{StaticResource SignCell}" />
                                <DataGridTextColumn Header="Фишки" Binding="{Binding ChipText}" ElementStyle="{StaticResource SignCell}" />
                                <DataGridTextColumn Header="Chip EV" Binding="{Binding ChipEvText}" ElementStyle="{StaticResource SignCell}" />
                                <DataGridTextColumn Header="Удача" Binding="{Binding ChipLuckText}" ElementStyle="{StaticResource SignCell}" />
                                <DataGridTextColumn Header="Олл-ины" Binding="{Binding AllIns}" />
                                <DataGridTextColumn Header="Поле" Binding="{Binding FieldText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <GridSplitter Grid.Row="3" Height="5" Margin="0,4" HorizontalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}" />

                    <DockPanel Grid.Row="4">
                        <TextBlock x:Name="TourneyChartNote" DockPanel.Dock="Top" Style="{StaticResource H}" Margin="0,0,0,4"
                                   TextWrapping="Wrap" Text="Фишки и Chip EV нарастающим итогом" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Игроков за столом:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox x:Name="TourneyPlayersFilter" Width="120" SelectedIndex="0" SelectionChanged="TourneyFilter_Changed">
                                <ComboBoxItem Content="Все" />
                                <ComboBoxItem Content="2 (хедз-ап)" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4–6" />
                                <ComboBoxItem Content="7+" />
                            </ComboBox>
                            <TextBlock Text="Позиция:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <ComboBox x:Name="TourneyPositionFilter" Width="90" SelectionChanged="TourneyFilter_Changed" />
                            <TextBlock Text="Стек:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <ComboBox x:Name="TourneyStackFilter" Width="120" SelectedIndex="0" SelectionChanged="TourneyFilter_Changed">
                                <ComboBoxItem Content="Все" />
                                <ComboBoxItem Content="менее 10bb" />
                                <ComboBoxItem Content="10–25bb" />
                                <ComboBoxItem Content="25–50bb" />
                                <ComboBoxItem Content="более 50bb" />
                            </ComboBox>
                            <Button Content="Сбросить фильтры" Click="TourneyFiltersReset_Click" Margin="12,0,0,0" />
                            <TextBlock />
                        </DockPanel>
                        <sp:WpfPlot x:Name="TourneyPlot" />
                    </DockPanel>

                    <GridSplitter Grid.Row="5" Height="5" Margin="0,4" HorizontalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}" />

                    <DockPanel Grid.Row="6">
                        <TextBlock x:Name="TournamentListHeader" DockPanel.Dock="Top" Style="{StaticResource H}" Text="Турниры" Margin="0,0,0,4" />
                        <DataGrid x:Name="TournamentsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Формат" Binding="{Binding Format}" MinWidth="120" />
                                <DataGridTextColumn Header="Старт" Binding="{Binding StartLocal, StringFormat=dd.MM.yy HH:mm}" />
                                <DataGridTextColumn Header="Турнир" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Руки" Binding="{Binding Hands, Converter={StaticResource Num}}" />
                                <DataGridTextColumn Header="Входов" Binding="{Binding Entries}" />
                                <DataGridTextColumn Header="Бай-ин" Binding="{Binding BuyInText}" />
                                <DataGridTextColumn Header="Место" Binding="{Binding FinishText}" />
                                <DataGridTextColumn Header="Приз" Binding="{Binding WonText}" />
                                <DataGridTextColumn Header="Итог" Binding="{Binding ProfitText}" ElementStyle="{StaticResource SignCell}" />
                                <DataGridTextColumn Header="$EV" Binding="{Binding DollarEvText}" ElementStyle="{StaticResource SignCell}" />
                                <DataGridTextColumn Header="Фишки" Binding="{Binding ChipText}" ElementStyle="{StaticResource SignCell}" />
                                <DataGridTextColumn Header="Chip EV" Binding="{Binding ChipEvText}" ElementStyle="{StaticResource SignCell}" />
                                <DataGridTextColumn Header="Олл-ины" Binding="{Binding AllIns}" />
                                <DataGridTextColumn Header="Валюта" Binding="{Binding Currency}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ── Отчёты ──────────────────────────────────────────── -->
            <TabItem Header="Отчёты" x:Name="ReportsTab">
                <views:ReportsView x:Name="Reports" />
            </TabItem>

            <!-- ── Раздачи ─────────────────────────────────────────── -->
            <!-- ── Аналитика: стартовые руки, сила руки, графики ───── -->
            <TabItem Header="Аналитика" x:Name="AnalyticsTab">
                <views:AnalyticsView x:Name="Analytics" />
            </TabItem>

            <TabItem Header="Раздачи" x:Name="HandsTab">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <ComboBox x:Name="HandsKind" Width="110" SelectedIndex="0" SelectionChanged="HandsSelector_Changed" ToolTip="Вид игры">
                            <ComboBoxItem Content="Все" />
                            <ComboBoxItem Content="Кеш" />
                            <ComboBoxItem Content="Турниры" />
                        </ComboBox>
                        <ComboBox x:Name="HandsPosition" Width="90" Margin="6,0" SelectionChanged="HandsSelector_Changed" ToolTip="Позиция Hero" />
                        <Button Style="{StaticResource AccentButton}" Content="Показать" Click="HandsShow_Click" />
                        <Button Content="◀" Click="HandsPrev_Click" ToolTip="Предыдущая страница — более новые раздачи" />
                        <Button Content="▶" Click="HandsNext_Click" ToolTip="Следующая страница — более старые раздачи" />
                        <TextBlock x:Name="HandsPageText" VerticalAlignment="Center" Style="{StaticResource Dim}" />
                        <TextBlock Text="  двойной клик или Enter — реплеер" VerticalAlignment="Center" Style="{StaticResource Dim}" />
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Фильтр:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Right" Content="Сбросить" Click="HandsFilterReset_Click" Margin="6,0,0,0" />
                        <TextBox x:Name="HandsFilterBox" FontFamily="Consolas" KeyDown="HandsFilterBox_KeyDown"
                                 ToolTip="Выражение над вашей рукой, как в условиях статов. Enter — применить.&#10;Примеры:&#10;  Pfr &amp;&amp; SawShowdown &amp;&amp; !WonAtShowdown&#10;  NetWonBbX100 &lt;= -5000&#10;  EvNetWon != null &amp;&amp; EvNetWon - NetWon &gt; 1000&#10;  HoleClass == 0 &amp;&amp; Position == &quot;BB&quot;  (AA на BB)&#10;  ThreeBet &amp;&amp; Hand.PlayersDealt &gt;= 5&#10;Поля: Vpip Pfr ThreeBet SawFlop SawTurn SawRiver SawShowdown WonAtShowdown WonHand AllIn Position StackBb NetWon NetWonBbX100 EvNetWon Invested HoleClass Hand.BombPot Hand.RunItTwice Hand.PlayersDealt Hand.BigBlind" />
                    </DockPanel>
                    <DataGrid x:Name="HandsGrid" MouseDoubleClick="HandsGrid_DoubleClick" PreviewKeyDown="HandsGrid_KeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Binding="{Binding PlayedLocal, StringFormat=dd.MM.yy HH:mm:ss}" />
                            <DataGridTextColumn Header="Стол" Binding="{Binding Row.Table}" Width="*" />
                            <DataGridTextColumn Header="Ставки" Binding="{Binding StakesText}" />
                            <DataGridTextColumn Header="Поз." Binding="{Binding PositionText}" />
                            <DataGridTextColumn Header="Карты" Binding="{Binding Row.Cards}" />
                            <DataGridTextColumn Header="Итог" Binding="{Binding NetText}" ElementStyle="{StaticResource SignCell}" />
                            <DataGridTextColumn Header="bb" Binding="{Binding NetBb, StringFormat=F1}" ElementStyle="{StaticResource SignCell}" />
                            <DataGridTextColumn Header="EV" Binding="{Binding EvText}" ElementStyle="{StaticResource SignCell}" />
                            <DataGridTextColumn Header="Банк" Binding="{Binding PotText}" />
                            <DataGridTextColumn Header="#" Binding="{Binding Row.ExternalId}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ── Игроки ──────────────────────────────────────────── -->
            <TabItem Header="Игроки" x:Name="PlayersTab">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,8,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button x:Name="PlayerSearchButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Найти" Click="PlayerSearch_Click" Margin="6,0,0,0" />
                            <TextBlock DockPanel.Dock="Left" Text="Ник:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="PlayerSearchBox" KeyDown="PlayerSearchBox_KeyDown"
                                     ToolTip="Начало ника; пустое поле — игроки с наибольшим числом раздач. Enter — искать" />
                        </DockPanel>
                        <DataGrid x:Name="PlayersGrid" SelectionChanged="PlayersGrid_SelectionChanged" MouseRightButtonUp="PlayersGrid_RightClick"
                                  ToolTip="Правый клик — цветовая метка, подпись, заметка">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="18">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="10" Height="10" Fill="{Binding MarkerColor}" ToolTip="{Binding MarkerTitle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ник" Binding="{Binding Nickname}" Width="*" />
                                <DataGridTextColumn Header="Руки" Binding="{Binding Hands, Converter={StaticResource Num}}" />
                                <DataGridTextColumn Header="Тип" Binding="{Binding MarkerTitle}" />
                                <DataGridTextColumn Header="Подпись" Binding="{Binding Caption}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="160" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PlayerTitle" Style="{StaticResource H}" Text="Выберите игрока" Margin="0,0,12,0" />
                            <ComboBox x:Name="PlayerKind" Width="110" SelectedIndex="0" SelectionChanged="PlayerKind_Changed" VerticalAlignment="Center">
                                <ComboBoxItem Content="Кеш" />
                                <ComboBoxItem Content="Турниры" />
                            </ComboBox>
                            <TextBlock Text="Стат:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="14,0,6,0" />
                            <TextBox x:Name="PlayerStatFilter" Width="170" VerticalAlignment="Center" TextChanged="PlayerStatFilter_Changed"
                                     ToolTip="Показать статы, в названии или коде которых есть этот текст" />
                            <CheckBox x:Name="PlayerStatNonEmpty" Content="только с выборкой" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                                      Click="PlayerStatFilter_Changed" ToolTip="Скрыть статы, по которым у игрока нет ни одного случая" />
                            <TextBlock x:Name="PlayerStatCount" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <DataGrid x:Name="PlayerStatsGrid" Grid.Row="1" Margin="0,6,0,0" MouseDoubleClick="PlayerStatsGrid_DoubleClick" ToolTip="Двойной клик — попап стата">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Стат" Binding="{Binding Title}" Width="160" />
                                <DataGridTextColumn Header="Значение" Binding="{Binding Value}" />
                                <DataGridTextColumn Header="Выборка" Binding="{Binding Sample, Converter={StaticResource Num}}" />
                                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Margin="0,8,0,4">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Добавить заметку" Click="AddNote_Click" Margin="6,0,0,0" />
                                <TextBlock DockPanel.Dock="Left" Text="Заметка:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="NoteBox" KeyDown="NoteBox_KeyDown" ToolTip="Текст заметки об игроке. Enter — добавить" />
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Склеить: это тот же игрок" Click="MergePlayer_Click" Margin="6,0,0,0"
                                        ToolTip="Указанный ник станет алиасом выбранного игрока: его раздачи, статы и заметки перейдут сюда" />
                                <TextBlock DockPanel.Dock="Left" Text="Старый ник:" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="MergeBox" />
                            </DockPanel>
                        </StackPanel>
                        <ListBox x:Name="NotesList" Grid.Row="3" DisplayMemberPath="Text" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── Ликфайндер ──────────────────────────────────────── -->
            <TabItem Header="Ликфайндер" x:Name="LeaksTab">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="LeaksKind" Width="120" SelectedIndex="0" SelectionChanged="LeaksKind_Changed">
                            <ComboBoxItem Content="Кеш" />
                            <ComboBoxItem Content="Турниры" />
                        </ComboBox>
                        <TextBlock x:Name="LeaksNote" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Text="Ваши статы против пула — всех остальных игроков из вашей же базы. Отклонение считается значимым при достаточной выборке." />
                    </StackPanel>
                    <DataGrid x:Name="LeaksGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Стат" Binding="{Binding Title}" Width="160" />
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" />
                            <DataGridTextColumn Header="Вы" Binding="{Binding HeroText}" />
                            <DataGridTextColumn Header="Выборка" Binding="{Binding HeroSample, Converter={StaticResource Num}}" />
                            <DataGridTextColumn Header="Пул" Binding="{Binding PoolText}" />
                            <DataGridTextColumn Header="Выборка пула" Binding="{Binding PoolSample, Converter={StaticResource Num}}" />
                            <DataGridTextColumn Header="Разница" Binding="{Binding DiffText}" ElementStyle="{StaticResource SignCell}" />
                            <DataGridTextColumn Header="Оценка" Binding="{Binding Verdict}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ── HUD ─────────────────────────────────────────────── -->
            <TabItem Header="HUD" x:Name="HudTab">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox x:Name="HudEnabledBox" Content="HUD включён" VerticalAlignment="Center" Click="HudEnabled_Click" Margin="0,0,12,0" />
                        <CheckBox x:Name="SessionWidgetBox" Content="Виджет сессии" VerticalAlignment="Center" Click="SessionWidget_Click" Margin="0,0,12,0"
                                  ToolTip="Маленькое окно поверх столов: сколько сыграно в этой сессии, итог в bb и график. Только по завершённым раздачам." />
                        <CheckBox x:Name="AutoProfileBox" Content="9max / 6max по столу" VerticalAlignment="Center" Click="AutoProfile_Click" Margin="0,0,12,0"
                                  ToolTip="Если выбрана раскладка с «9max» в имени и сохранена парная «6max» (или наоборот), для каждого стола берётся подходящая по числу мест." />
                        <Button Content="Обновить" Click="HudRefresh_Click" />
                        <Button Content="Привязать выбранное окно к выбранному столу" Click="HudBind_Click" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Раскладка:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="HudProfileBox" Width="200" SelectionChanged="HudProfileBox_Changed" />
                        <Button Style="{StaticResource AccentButton}" Content="Редактор HUD и попапов"
                                Click="HudEditor_Click" Margin="8,0,0,0" />
                        <Button Content="Привязка попапов…" Click="PopupBinding_Click" Margin="6,0,0,0"
                                ToolTip="Какую вкладку попапа открывает каждая ячейка панели HUD" />
                        <Button Content="Импорт пакета HUD…" Click="HudPackageImport_Click" Margin="6,0,0,0"
                                ToolTip="Файл *.hudpack.json: раскладка вместе со статами. Статы добавятся в базу и досчитаются" />
                        <Button Content="Цветовые метки…" Click="Markers_Click" Margin="6,0,0,0"
                                ToolTip="Типы оппонентов и их цвета: метка ставится правым кликом по панели HUD или во вкладке «Игроки»" />
                    </StackPanel>
                    <TextBlock x:Name="HudHint" DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Dim}" Margin="0,0,0,6"
                               Text="Окна клиента ищутся по имени процесса и классу окна (Настройки). Привязка: .data-канал → заголовок окна + последняя раздача стола из HH → ручная привязка. Статы строятся только по вашим раздачам (правила рума)." />
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Height="300">
                        <DockPanel>
                            <!-- Этот список — отдельная простая раскладка. Пока выбрана другая (сетка из редактора), на панели он не виден:
                                 об этом говорит подсказка справа, иначе правки списка выглядят как «HUD не обновляется». -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource H}" Text="Простой список статов" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <ComboBox DockPanel.Dock="Left" x:Name="ProfileKind" Width="120" SelectedIndex="0" SelectionChanged="ProfileKind_Changed"
                                          ToolTip="Вид игры: от него зависят и раскладка выше, и этот список">
                                    <ComboBoxItem Content="Кеш" />
                                    <ComboBoxItem Content="Турниры" />
                                </ComboBox>
                                <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Content="Сохранить список" Click="ProfileSave_Click" Margin="12,0,10,0" />
                                <TextBlock x:Name="ProfileStatus" Style="{StaticResource Dim}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Доступные статы" Style="{StaticResource Dim}" Margin="0,0,0,4" />
                                    <ListBox x:Name="ProfileAvailable" MouseDoubleClick="ProfileAdd_Click" />
                                </DockPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                    <Button Content="→" Click="ProfileAdd_Click" Margin="0,0,0,6" />
                                    <Button Content="←" Click="ProfileRemove_Click" Margin="0,0,0,6" />
                                    <Button Content="↵ строка" Click="ProfileBreak_Click" />
                                </StackPanel>
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="В панели (сверху вниз; «── новая строка ──» — перенос)" Style="{StaticResource Dim}" Margin="0,0,0,4" />
                                    <ListBox x:Name="ProfileSelected" MouseDoubleClick="ProfileRemove_Click" />
                                </DockPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                                    <Button Content="↑" Click="ProfileUp_Click" Margin="0,0,0,6" />
                                    <Button Content="↓" Click="ProfileDown_Click" />
                                </StackPanel>
                                <DockPanel Grid.Column="4" Margin="8,0,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Предпросмотр панели" Style="{StaticResource Dim}" Margin="0,0,0,4" />
                                    <Border Background="#1A1930" BorderBrush="#453F86" BorderThickness="1" CornerRadius="4" Padding="6,4" VerticalAlignment="Top">
                                        <StackPanel x:Name="ProfilePreview" />
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <DockPanel Margin="0,0,6,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="Окна столов" />
                            <DataGrid x:Name="HudWindowsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Заголовок" Binding="{Binding WindowTitle}" Width="*" />
                                    <DataGridTextColumn Header="Стол" Binding="{Binding TableName}" Width="*" />
                                    <DataGridTextColumn Header="Игроков" Binding="{Binding Players}" />
                                    <DataGridTextColumn Header="Источник" Binding="{Binding Source}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Column="1">
                            <TextBlock x:Name="ActiveTablesHeader" DockPanel.Dock="Top" Style="{StaticResource H}" Text="Активные столы" />
                            <DataGrid x:Name="ActiveTablesGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Стол" Binding="{Binding TableName}" Width="*" />
                                    <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" />
                                    <DataGridTextColumn Header="Мест" Binding="{Binding MaxSeats}" />
                                    <DataGridTextColumn Header="Последняя рука" Binding="{Binding LastHandLocal, StringFormat=dd.MM HH:mm:ss}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ── Импорт ──────────────────────────────────────────── -->
            <TabItem Header="Импорт" x:Name="ImportTab">
                <!-- Перетаскивание принимает вся вкладка: целиться в рамку не нужно. Фон обязателен — без него пустые места не ловят Drop. -->
                <Grid AllowDrop="True" Background="Transparent" Drop="Import_Drop" DragOver="Import_DragOver" DragLeave="Import_DragLeave">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource H}" Text="База данных" />
                            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                       Text="Раздачи загружаются в выбранную базу. Отдельную базу удобно завести под тест, другой аккаунт или присланную выгрузку — рабочая статистика с ней не смешается." />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox x:Name="DbCombo" Width="250" SelectionChanged="DbCombo_Changed" ToolTip="Активная база. Выберите другую, чтобы переключиться" />
                                <Button Content="Создать…" Click="DbCreate_Click" Margin="6,0,0,0" ToolTip="Новая пустая база с вашим именем" />
                                <Button Content="Удалить…" Click="DbDelete_Click" Margin="6,0,0,0" ToolTip="Удалить выбранную базу со всеми раздачами" />
                                <Button x:Name="DbRecalcButton" Content="Пересчитать…" Click="DbRecalc_Click" Margin="6,0,0,0"
                                        ToolTip="Проверка и пересчёт статистики выбранной базы" />
                            </StackPanel>
                            <TextBlock x:Name="DbActionText" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Dim}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource H}" Text="Мои ники (Hero)" />
                            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                                       Text="Принимаются только ваши раздачи — так требуют правила румов. Ник можно не вводить заранее: трекер найдёт его в файлах и спросит, ваш ли это аккаунт." />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ListBox x:Name="HeroList" Width="250" Height="70" />
                                <StackPanel Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBox x:Name="HeroBox" Width="150" ToolTip="Ник в руме" />
                                        <ComboBox x:Name="HeroRoomCombo" Width="170" Margin="6,0,0,0" ToolTip="Рум, в котором этот ник ваш" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Добавить" Click="HeroAdd_Click" />
                                        <Button Content="Удалить" Click="HeroRemove_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource H}" Text="Загрузка раздач" />
                        <Grid Margin="0,4,0,0">
                            <Rectangle x:Name="DropFrame" RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="5 4"
                                       Stroke="{DynamicResource BorderBrush}" Fill="{DynamicResource Bg1}" />
                            <StackPanel Margin="16,14,16,14">
                                <TextBlock FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Text="Перетащите сюда папку, файлы истории или архив (.zip, .rar, .7z)" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,8">
                                    <Button x:Name="ImportFilesButton" Style="{StaticResource AccentButton}" Content="Выбрать файлы или архив…" Click="ImportBrowseFiles_Click" />
                                    <Button x:Name="ImportFolderButton" Content="Выбрать папку…" Click="ImportBrowse_Click" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center"
                                           Text="Архив распаковывать не нужно, вложенные папки и архивы читаются сами. Рум определяется по содержимому файла, поэтому раздачи разных румов можно загружать вместе. Уже загруженные раздачи повторно не добавляются." />
                            </StackPanel>
                        </Grid>
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="ImportCancelButton" DockPanel.Dock="Right" Content="Отмена" Click="ImportCancel_Click" IsEnabled="False" />
                            <Button x:Name="ImportButton" DockPanel.Dock="Right" Content="Импортировать" Click="Import_Click" Margin="6,0,0,0"
                                    ToolTip="Импорт пути из поля слева (повтор последнего импорта)" />
                            <TextBox x:Name="ImportFolderBox" ToolTip="Что импортировать: папка, файл или архив. Несколько путей разделяются знаком |" />
                        </DockPanel>
                        <CheckBox x:Name="ImportObservedBox" Margin="0,8,0,0" Click="ImportObserved_Click"
                                  Content="Загружать и раздачи без меня за столом (наблюдаемые, купленные) — на свой риск: правила румов это запрещают"
                                  ToolTip="Нужно для статистики на оппонентов по сторонним раздачам. Правила большинства румов это запрещают — решение и риск на вас. All-in EV для таких раздач не считается." />
                        <CheckBox x:Name="ImportGgBox" Margin="0,4,0,0" Click="ImportGg_Click"
                                  Content="Загружать раздачи GG (GGPoker, PokerOK) — на свой риск: политика GG запрещает сторонний импорт её раздач"
                                  ToolTip="Security &amp; Ecology Policy сети GG запрещает сторонним программам импортировать и конвертировать её истории раздач, в том числе выгруженные из PokerCraft. При запущенном клиенте GG её раздачи не импортируются в любом случае; раздачи других румов — как обычно." />
                        <ProgressBar x:Name="ImportProgressBar" Height="14" Margin="0,6,0,2" />
                        <TextBlock x:Name="ImportStatusText" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource H}" Text="Ошибки импорта" />
                        <Button Content="Обновить" Click="ImportErrors_Click" Margin="12,4,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="ImportErrorsGrid" SelectionChanged="ImportErrorsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Когда" Binding="{Binding SeenAt, StringFormat=dd.MM HH:mm}" />
                                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox x:Name="ImportErrorBody" Grid.Column="1" Margin="6,0,0,0" IsReadOnly="True" FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── Статы ───────────────────────────────────────────── -->
            <TabItem Header="Статы" x:Name="StatsTab">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,8,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left" Content="Новый стат" Click="StatNew_Click" Margin="0,0,8,0" />
                            <TextBlock x:Name="StatSearchCount" DockPanel.Dock="Right" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox x:Name="StatSearchBox" TextChanged="StatSearchBox_Changed" VerticalAlignment="Center"
                                     ToolTip="Поиск стата по коду или заголовку" />
                        </DockPanel>
                        <DataGrid x:Name="StatDefsGrid" SelectionChanged="StatDefsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="*" />
                                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" />
                                <DataGridTextColumn Header="Тип" Binding="{Binding Scope}" />
                                <DataGridTextColumn Header="v" Binding="{Binding Version}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Dim}" Margin="0,0,0,6"
                                   Text="Условия — C#-подобные выражения над DecisionPoint (decision) или HandPlayerFacts (hand); expression ссылается на plain-статы как code.cases / code.hits / code.sum. При сохранении стат компилируется; изменённый стат пересчитывается селективно." />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Проверить и прогнать по 1000 рукам" Click="StatTrial_Click" />
                            <Button Style="{StaticResource AccentButton}" Content="Сохранить и пересчитать" Click="StatSave_Click" />
                            <TextBlock x:Name="StatResultText" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox x:Name="StatJsonBox" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ── Настройки ───────────────────────────────────────── -->
            <TabItem Header="Настройки" x:Name="SettingsTab">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="660" MinWidth="440" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                    <!-- Одна настройка — одна строка: подпись слева, поле справа. Составные строки собраны на WrapPanel,
                         чтобы при узком окне поля переносились, а не уезжали за край формы. -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Сохранить и применить" Click="SettingsSave_Click"
                                        ToolTip="Сохраняет настройки и перезапускает подключение к базе, авто-импорт и HUD" />
                                <Button Content="Бэкап БД сейчас" Click="Backup_Click" ToolTip="Резервная копия активной базы (pg_dump) в папку бэкапов" />
                                <Button Content="Папка данных…" Click="OpenDataFolder_Click"
                                        ToolTip="Открыть папку с настройками, раскладками HUD и журналами в проводнике" />
                            </StackPanel>
                            <TextBlock x:Name="SettingsStatus" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                            <StackPanel x:Name="SettingsForm">
                                <StackPanel.Resources>
                                    <Style x:Key="SetLabel" TargetType="TextBlock">
                                        <Setter Property="Width" Value="210" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="DockPanel.Dock" Value="Left" />
                                    </Style>
                                    <Style x:Key="SetRow" TargetType="DockPanel">
                                        <Setter Property="Margin" Value="0,2" />
                                    </Style>
                                    <Style x:Key="SetHint" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="10,0,6,0" />
                                    </Style>
                                </StackPanel.Resources>

                                <TextBlock Style="{StaticResource H}" Text="База и рум" Margin="0,0,0,6" />
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Рум" />
                                    <ComboBox x:Name="SetRoom" Width="200" HorizontalAlignment="Left" SelectionChanged="SetRoom_Changed" />
                                </DockPanel>
                                <TextBlock x:Name="SetRoomRules" Margin="210,0,0,4" TextWrapping="Wrap" Style="{StaticResource Dim}" />
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Строка подключения" />
                                    <TextBox x:Name="SetConn" ToolTip="Подключение к PostgreSQL. Базу удобнее выбирать на вкладке «Импорт»" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource H}" Text="Импорт" />
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Папка истории раздач" />
                                    <Button DockPanel.Dock="Right" Content="Обзор…" Click="SetHhBrowse_Click" Margin="6,0,0,0" />
                                    <TextBox x:Name="SetHhFolder" ToolTip="Папка, куда клиент рума пишет hand history: за ней следит авто-импорт" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Авто-импорт" />
                                    <CheckBox x:Name="SetAutoImport" Margin="0,4" Content="загружать новые раздачи из этой папки во время игры" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Папка .data (рассадка)" />
                                    <Button DockPanel.Dock="Right" Content="Обзор…" Click="SetDataBrowse_Click" Margin="6,0,0,0" />
                                    <TextBox x:Name="SetDataFolder" ToolTip="Канал клиента WPN с рассадкой за столами. Читается только рассадка — карты и ход текущей руки не используются" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Сдвиг мест .data → HH" />
                                    <TextBox x:Name="SetSeatOffset" Width="60" HorizontalAlignment="Left"
                                             ToolTip="На сколько номер места в .data отличается от номера в hand history (обычно 1)" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource H}" Text="HUD" />
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="HUD" />
                                    <CheckBox x:Name="SetHud" Margin="0,4" Content="показывать панели поверх столов" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Процесс клиента" />
                                    <TextBox x:Name="SetProcess" ToolTip="Имя процесса клиента рума без .exe — в его окнах ищутся столы" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Класс окна стола" />
                                    <TextBox x:Name="SetWindowClass" ToolTip="Класс окна стола; пусто — подходят любые окна процесса" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Стол активен, часов" />
                                    <WrapPanel>
                                        <TextBox x:Name="SetActiveHours" Width="60" />
                                        <TextBlock Style="{StaticResource SetHint}" Text="после последней сыгранной за ним раздачи" />
                                    </WrapPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Прозрачность панелей" />
                                    <WrapPanel>
                                        <TextBox x:Name="SetOpacity" Width="60" />
                                        <TextBlock Style="{StaticResource SetHint}" Text="от 0.2 (почти прозрачные) до 1" />
                                    </WrapPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Попапы открываются" />
                                    <WrapPanel>
                                        <ComboBox x:Name="SetPopupTrigger" Width="150" SelectionChanged="PopupTrigger_Changed">
                                            <ComboBoxItem Content="по наведению" />
                                            <ComboBoxItem Content="по клику" />
                                        </ComboBox>
                                        <TextBlock x:Name="SetHoverDelayLabel" Style="{StaticResource SetHint}" Text="показать через, мс" />
                                        <TextBox x:Name="SetHoverDelay" Width="60" />
                                        <TextBlock x:Name="SetHoverHideLabel" Style="{StaticResource SetHint}" Text="скрыть через, мс" />
                                        <TextBox x:Name="SetHoverHide" Width="60" />
                                    </WrapPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Горячая клавиша HUD" />
                                    <WrapPanel>
                                        <TextBox x:Name="SetHotkey" Width="130" />
                                        <TextBlock Style="{StaticResource SetHint}" Text="скрыть или показать панели" />
                                    </WrapPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Выборка в ячейках" />
                                    <WrapPanel>
                                        <TextBox x:Name="SetSampleBelow" Width="60"
                                                 ToolTip="«50₂» — значение и мелкая цифра выборки, если случаев меньше указанного; 0 — не показывать" />
                                        <TextBlock Style="{StaticResource SetHint}" Text="мелкая цифра выборки, если случаев меньше" />
                                        <CheckBox x:Name="SetCap99" Content="99 вместо 100" VerticalAlignment="Center" Margin="8,0,0,0"
                                                  ToolTip="Показывать 99 вместо 100, чтобы ячейка не расширялась до трёх знаков" />
                                    </WrapPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Простой список статов (кеш)" />
                                    <TextBox x:Name="SetCashStats" ToolTip="Коды статов для раскладки «простой список», «|» — новая строка. Удобнее собирать на вкладке «HUD»" />
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Простой список статов (турниры)" />
                                    <TextBox x:Name="SetMttStats" ToolTip="Коды статов для раскладки «простой список», «|» — новая строка. Удобнее собирать на вкладке «HUD»" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource H}" Text="Сессии и резервные копии" />
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Разрыв сессии, мин" />
                                    <WrapPanel>
                                        <TextBox x:Name="SetSessionGap" Width="60" />
                                        <TextBlock Style="{StaticResource SetHint}" Text="перерыв дольше — уже новая сессия" />
                                    </WrapPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Автобэкап базы" />
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource SetHint}" Text="раз в, дней (0 — выкл.)" Margin="0,0,6,0" />
                                        <TextBox x:Name="SetBackupDays" Width="50" />
                                        <TextBlock Style="{StaticResource SetHint}" Text="хранить копий" />
                                        <TextBox x:Name="SetKeepBackups" Width="50" />
                                    </WrapPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SetRow}">
                                    <TextBlock Style="{StaticResource SetLabel}" Text="Папка бэкапов" />
                                    <Button DockPanel.Dock="Right" Content="Обзор…" Click="SetBackupBrowse_Click" Margin="6,0,0,0" />
                                    <TextBox x:Name="SetBackupFolder" ToolTip="Куда складывать резервные копии; пусто — «Документы\PKTracker\backups»" />
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="5" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}" />
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="Папка журналов…" Click="OpenLogFolder_Click" VerticalAlignment="Center"
                                    ToolTip="Журналы за прошлые дни — по файлу на день" />
                            <TextBlock Style="{StaticResource H}" Text="Журнал" ToolTip="События базы, импорта, HUD и .data-канала; новые сверху" />
                        </DockPanel>
                        <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
